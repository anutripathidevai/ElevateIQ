# ---- Database (Azure Postgres Flexible Server) ----
# LOCAL DEV: leave DATABASE_URL BLANK to run without a database. The app then
# serves the curated problem bank from content/*.json, skips all persistence,
# and treats you as a guest so AI review/mock stay testable. Set it for prod.
# postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/interviewprep?sslmode=require
DATABASE_URL=

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
# Optional for local dev (a dev fallback secret is used when blank).
# REQUIRED in production — it signs/encrypts the session cookie.
AUTH_SECRET=
# Public URL of the app. In dev: http://localhost:3000. In prod set to your
# deployed URL, e.g. https://compileready.com
# (Auth.js also trusts the proxy host via trustHost, but setting this is safest.)
AUTH_URL=http://localhost:3000

# Email/password sign-in works whenever DATABASE_URL is set — no extra config.
# (Run `npm run db:deploy` once to apply the passwordHash migration.)

# GitHub OAuth app (optional; sign-in button is hidden until both are set)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (optional; sign-in button is hidden until both are set).
# Authorized redirect URI to register with Google:
#   https://compileready.com/api/auth/callback/google
# For local dev also add: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn OAuth app (optional; sign-in button is hidden until both are set).
# Use LinkedIn's "Sign In with LinkedIn using OpenID Connect" product
# (scopes: openid profile email). Authorized redirect URL to register:
#   https://compileready.com/api/auth/callback/linkedin
# For local dev also add: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# ---- Transactional email (optional) ----
# Password reset by email is only offered when an email channel is configured.
# Until then, the forgot-password page honestly directs users to support instead
# of pretending an email was sent. Set AUTH_EMAIL_FROM plus ONE provider key.
AUTH_EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# ---- Azure OpenAI ----
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Limits ----
# Max AI reviews/mock messages per user per day
DAILY_AI_LIMIT=50
