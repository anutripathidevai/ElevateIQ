# ---- Database (Azure Postgres Flexible Server) ----
# LOCAL DEV: leave DATABASE_URL BLANK to run without a database. The app then
# serves the curated problem bank from content/*.json, skips all persistence,
# and treats you as a guest so AI review/mock stay testable. Set it for prod.
# postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/interviewprep?sslmode=require
DATABASE_URL=

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
# Optional for local dev (a dev fallback secret is used when blank).
# REQUIRED in production.
AUTH_SECRET=
# Public URL of the app. In dev: http://localhost:3000. In prod set to your
# deployed URL, e.g. https://interviewprep.<region>.azurecontainerapps.io
# (Auth.js also trusts the proxy host via trustHost, but setting this is safest.)
AUTH_URL=http://localhost:3000

# GitHub OAuth app (optional in dev; sign-in button hidden if unset)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (optional in dev; sign-in button hidden if unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Azure OpenAI ----
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Limits ----
# Max AI reviews/mock messages per user per day
DAILY_AI_LIMIT=50
