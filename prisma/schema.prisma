// Prisma schema — unified Problem model across all tracks.
// Adding a track = add a value to TrackKey + a content/*.json file (see content/README.md).

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl target is what the Alpine container needs.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrackKey {
  DSA
  SYSTEM_DESIGN
  LLD
  BEHAVIORAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  TODO
  ATTEMPTED
  SOLVED
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  image             String?
  createdAt         DateTime           @default(now())
  submissions       Submission[]
  progress          Progress[]
  mockInterviews    MockInterview[]
  // Phase 2 career modules
  questionBookmarks QuestionBookmark[]
  questionProgress  QuestionProgress[]
  starStories       StarStory[]
  panelInterviews   PanelInterview[]
}

model Problem {
  id                String       @id @default(cuid())
  track             TrackKey
  slug              String       @unique
  title             String
  difficulty        Difficulty
  tags              String[]
  statementMD       String
  constraints       String?
  hints             String[]
  referenceSolution String?
  // Optional in-browser judge spec (starter code + test cases) for runnable
  // problems (DSA). Shape mirrors lib/judge/types.ts JudgeSpec.
  judgeSpec         Json?
  // Optional structured LLD solution (approach + steps + Java classes +
  // design patterns). Shape mirrors lib/lld/types.ts LldSolution.
  solution          Json?
  createdAt         DateTime     @default(now())
  submissions       Submission[]
  progress          Progress[]

  @@index([track])
}

model Submission {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId  String
  language   String?
  content    String
  aiFeedback Json
  score      Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([problemId])
}

model Progress {
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  problem     Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId   String
  status      ProgressStatus @default(TODO)
  lastScore   Int?
  lastAttempt DateTime?
  nextReview  DateTime?

  @@id([userId, problemId])
  @@index([userId])
}

model MockInterview {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  trackKey   TrackKey
  // Optional problem this session is scoped to (LLD "discuss"/"mock on this
  // problem"). Null for generic track-level interviews.
  problemSlug String?
  // Session persona: "interview" (default) or "tutor".
  mode       String   @default("interview")
  transcript Json     @default("[]")
  summary    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// --- Phase 2: Company Question Bank ---------------------------------------
// Reference questions live in content/companies/*.json (keyed by a stable
// questionId), so bookmarks/progress reference that id rather than an FK.

model QuestionBookmark {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model QuestionProgress {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  questionId String
  status     ProgressStatus @default(TODO)
  updatedAt  DateTime       @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

// --- Phase 2: AI STAR Story Generator -------------------------------------

model StarStory {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  title                String
  situation            String
  task                 String
  action               String
  result               String
  skills               String[]
  leadershipPrinciples String[]
  suggestedQuestions   String[]
  tags                 String[]
  // Original free-form project details the story was generated from (for reuse).
  sourceProject        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// --- Phase 2: Mock Panel Interview ----------------------------------------

model PanelInterview {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       String
  focus      String
  // "active" while in progress, "completed" once the scorecard is generated.
  status     String   @default("active")
  // Array of PanelTurn: { personaId, role, content }.
  transcript Json     @default("[]")
  // PanelResult scorecard (scores, per-interviewer feedback, plan). Null until done.
  result     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
